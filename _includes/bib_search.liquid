{%- assign page_lang = page.lang | default: 'en' -%}
{%- assign t = site.data.i18n[page_lang] | default: site.data.i18n.en -%}
{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <input type="text" id="bibsearch" spellcheck="false" autocomplete="off" class="search bibsearch-form-input" placeholder="{{ t.filter_placeholder }}">
{% endif %}
