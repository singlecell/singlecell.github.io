{%- comment -%}
  Renders courses and learning materials from _data/teaching.yml in the page's language.
{%- endcomment -%}
{%- assign page_lang = page.lang | default: 'en' -%}
{%- assign courses = site.data.teaching.courses -%}
{%- comment -%} an item with `lang:` appears only on the page in that language {%- endcomment -%}
{%- assign materials = site.data.teaching.materials | where_exp: 'm', 'm.lang == nil or m.lang == page_lang' -%}
{%- if page_lang == 'zh' -%}
  {%- assign s_courses = '课程' -%}
  {%- assign s_materials = '学习资料' -%}
  {%- assign s_all = '全部' -%}
  {%- assign s_courses_empty = '课程信息即将更新。' -%}
  {%- assign s_materials_empty = '分析化学动图等学习资料正在整理中，敬请期待。' -%}
  {%- assign s_enlarge = '点击放大' -%}
  {%- assign s_download = '下载视频' -%}
  {%- assign s_close = '关闭' -%}
  {%- assign s_note = '' -%}
  {%- assign s_count = '个动图' -%}
{%- else -%}
  {%- assign s_courses = 'Courses' -%}
  {%- assign s_materials = 'Learning materials' -%}
  {%- assign s_all = 'All' -%}
  {%- assign s_courses_empty = 'Course information is coming soon.' -%}
  {%- assign s_materials_empty = 'Animations and other analytical-chemistry materials are being prepared. Check back soon.' -%}
  {%- assign s_enlarge = 'Click to enlarge' -%}
  {%- assign s_download = 'Download video' -%}
  {%- assign s_close = 'Close' -%}
  {%- assign s_note = '' -%}
  {%- assign s_count = 'animations' -%}
{%- endif -%}
<style>
/* keep the family name bold in the navbar on this page too */
#navbar .navbar-brand.title { font-weight: 700 !important; }
#navbar .navbar-brand .font-weight-bold { font-weight: 400 !important; }

.teach-intro {
  max-width: 46rem; margin: 0 0 2.5rem;
  font-size: 1.1rem; line-height: 1.75;
  color: var(--global-text-color); opacity: 0.88; text-wrap: pretty;
}
.teach-section { margin: 0 0 3rem; }
.teach-section > h2 {
  font-size: 1.35rem; font-weight: 700; margin: 0 0 1.2rem; text-transform: none;
  padding-bottom: 0.5rem; border-bottom: 1px solid var(--global-divider-color, rgba(128,128,128,0.18));
}
.teach-empty {
  margin: 0; padding: 1.4rem 1.6rem; border-radius: 14px; font-size: 0.95rem; opacity: 0.75;
  border: 1px dashed var(--global-divider-color, rgba(128,128,128,0.35));
}
.teach-empty i { margin-right: 0.5rem; color: var(--global-theme-color); }

.teach-card {
  background: var(--global-card-bg-color, var(--global-bg-color, #fff));
  border: 1px solid var(--global-divider-color, rgba(128,128,128,0.18));
  border-radius: 14px; overflow: hidden;
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}
.teach-card:hover { box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08); border-color: var(--global-theme-color); }

/* courses */
.teach-courses { display: flex; flex-direction: column; gap: 1.2rem; }
.teach-course { padding: 1.4rem 1.7rem; }
.teach-course-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.6rem; margin: 0 0 0.5rem; }
.teach-course-head h3 { font-size: 1.2rem; font-weight: 700; margin: 0; }
.teach-meta { font-size: 0.8rem; opacity: 0.6; }
.teach-desc { font-size: 0.95rem; line-height: 1.75; margin: 0 0 0.9rem; opacity: 0.85; text-wrap: pretty; }
.teach-desc:last-child { margin-bottom: 0; }
.teach-links { display: flex; flex-wrap: wrap; gap: 0.6rem; }
.teach-btn {
  display: inline-flex; align-items: center; gap: 0.45rem;
  padding: 0.4rem 0.95rem; border-radius: 8px; font-size: 0.85rem; font-weight: 500;
  text-decoration: none !important; transition: all 0.2s ease;
  color: var(--global-text-color);
  border: 1px solid var(--global-divider-color, rgba(128,128,128,0.3));
}
.teach-btn:hover { border-color: var(--global-theme-color); color: var(--global-theme-color); }

/* materials */
.teach-note { font-size: 0.88rem; opacity: 0.7; margin: -0.4rem 0 1.2rem; }
.teach-filters { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0 0 1.8rem; }
.teach-filter {
  font: inherit; font-size: 0.82rem; padding: 0.3rem 0.85rem; border-radius: 999px; cursor: pointer;
  background: transparent; color: var(--global-text-color);
  border: 1px solid var(--global-divider-color, rgba(128,128,128,0.3));
  transition: all 0.2s ease;
}
.teach-filter:hover { border-color: var(--global-theme-color); color: var(--global-theme-color); }
.teach-filter.active { background: var(--global-theme-color); border-color: var(--global-theme-color); color: #fff; }
.teach-group { margin: 0 0 2.4rem; }
.teach-group[hidden] { display: none; }
.teach-group > h3 { font-size: 1.1rem; font-weight: 700; margin: 0 0 1rem; display: flex; align-items: baseline; gap: 0.6rem; }
.teach-group > h3 .teach-meta { font-weight: 400; }
.teach-grid {
  display: grid; gap: 1.2rem;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 400px), 1fr));
}
.teach-material { display: flex; flex-direction: column; }
.teach-media {
  display: block; width: 100%; padding: 0; border: 0; cursor: zoom-in; background: #fff;
  border-bottom: 1px solid var(--global-divider-color, rgba(128,128,128,0.18));
}
.teach-media img, .teach-media video { display: block; width: 100%; height: auto; aspect-ratio: 1892 / 1010; object-fit: contain; background: #fff; }
.teach-material-body { padding: 0.8rem 1rem 1rem; display: flex; flex-direction: column; gap: 0.45rem; flex: 1; }
.teach-material-body h4 { font-size: 0.95rem; font-weight: 600; margin: 0; line-height: 1.45; }
.teach-material-body .teach-desc { font-size: 0.88rem; margin: 0; }
.teach-material-body .teach-links { margin-top: auto; padding-top: 0.2rem; }
.teach-material-body .teach-btn { padding: 0.25rem 0.7rem; font-size: 0.78rem; }

/* enlarged view */
.teach-lightbox {
  width: min(96vw, 1400px); max-width: none; max-height: 96vh; padding: 0; border: 0;
  border-radius: 12px; background: #fff; overflow: hidden;
}
.teach-lightbox::backdrop { background: rgba(0, 0, 0, 0.75); }
.teach-lightbox video, .teach-lightbox img { display: block; width: 100%; height: auto; max-height: calc(96vh - 3rem); object-fit: contain; }
.teach-lightbox-bar { display: flex; align-items: center; gap: 1rem; padding: 0.6rem 1rem; font-size: 0.9rem; color: #222; }
.teach-lightbox-bar span { flex: 1; min-width: 0; font-weight: 600; }
.teach-lightbox-bar a, .teach-lightbox-bar button { font: inherit; font-size: 0.85rem; color: #222; background: none; border: 0; cursor: pointer; padding: 0.2rem 0.4rem; }
.teach-lightbox-bar a:hover, .teach-lightbox-bar button:hover { color: var(--global-theme-color); }
</style>

<section class="teach-section">
  <h2>{{ s_courses }}</h2>
  {%- if courses and courses.size > 0 %}
  <div class="teach-courses">
    {%- for c in courses %}
    <div class="teach-card teach-course">
      <div class="teach-course-head">
        <h3>{{ c.name[page_lang] }}</h3>
        {%- if c.audience or c.term %}
        <span class="teach-meta">{{ c.audience[page_lang] }}{% if c.audience and c.term %} · {% endif %}{{ c.term[page_lang] }}</span>
        {%- endif %}
      </div>
      {%- if c.description %}<p class="teach-desc">{{ c.description[page_lang] }}</p>{% endif %}
      {%- if c.links %}
      <div class="teach-links">
        {%- for l in c.links %}
        <a class="teach-btn" href="{{ l.url | relative_url }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-link"></i>{{ l.label[page_lang] }}</a>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
  {%- else %}
  <p class="teach-empty"><i class="fa-solid fa-chalkboard-user"></i>{{ s_courses_empty }}</p>
  {%- endif %}
</section>

<section class="teach-section">
  <h2>{{ s_materials }}</h2>
  {%- if materials and materials.size > 0 %}
  {%- if s_note != '' %}<p class="teach-note">{{ s_note }}</p>{% endif %}
  {%- assign cats = '' | split: '' -%}
  {%- for m in materials -%}
    {%- if m.category -%}{%- assign cats = cats | push: m.category[page_lang] -%}{%- endif -%}
  {%- endfor -%}
  {%- assign cats = cats | uniq -%}
  {%- assign uncategorized = materials | where_exp: 'm', 'm.category == nil' -%}
  {%- assign groups = cats -%}
  {%- if uncategorized.size > 0 -%}{%- assign groups = groups | push: '' -%}{%- endif %}
  {%- if cats.size > 1 %}
  <div class="teach-filters" role="group">
    <button type="button" class="teach-filter active" data-cat="">{{ s_all }}</button>
    {%- for cat in cats %}
    <button type="button" class="teach-filter" data-cat="{{ cat | escape }}">{{ cat }}</button>
    {%- endfor %}
  </div>
  {%- endif %}
  {%- for cat in groups %}
  {%- if cat == '' -%}
    {%- assign items = uncategorized -%}
  {%- else -%}
    {%- assign items = '' | split: '' -%}
    {%- for m in materials -%}{%- if m.category and m.category[page_lang] == cat -%}{%- assign items = items | push: m -%}{%- endif -%}{%- endfor -%}
  {%- endif %}
  <div class="teach-group" data-cat="{{ cat | escape }}">
    {%- if cat != '' and cats.size > 1 %}
    <h3>{{ cat }}<span class="teach-meta">{{ items.size }} {{ s_count }}</span></h3>
    {%- endif %}
    <div class="teach-grid">
      {%- for m in items %}
      {%- assign media_url = m.media | prepend: 'assets/' | relative_url -%}
      {%- assign ext = m.media | split: '.' | last | downcase %}
      <div class="teach-card teach-material">
        {%- if m.media %}
        <button type="button" class="teach-media" title="{{ s_enlarge }}" data-src="{{ media_url }}" data-kind="{% if ext == 'mp4' or ext == 'webm' %}video{% else %}image{% endif %}"{% if m.download %} data-download="{{ m.download | prepend: 'assets/' | relative_url }}"{% endif %}>
          {%- if ext == 'mp4' or ext == 'webm' %}
          <video data-src="{{ media_url }}"{% if m.poster %} data-poster="{{ m.poster | prepend: 'assets/' | relative_url }}"{% endif %} loop muted playsinline preload="none" aria-label="{{ m.title[page_lang] | escape }}"></video>
          {%- else %}
          <img src="{{ media_url }}" alt="{{ m.title[page_lang] | escape }}" loading="lazy">
          {%- endif %}
        </button>
        {%- endif %}
        <div class="teach-material-body">
          <h4>{{ m.title[page_lang] }}</h4>
          {%- if m.description %}<p class="teach-desc">{{ m.description[page_lang] }}</p>{% endif %}
          {%- if m.link or m.download %}
          <div class="teach-links">
            {%- if m.download %}
            <a class="teach-btn" href="{{ m.download | prepend: 'assets/' | relative_url }}" download><i class="fa-solid fa-download"></i>{{ s_download }}</a>
            {%- endif %}
            {%- if m.link %}
            <a class="teach-btn" href="{{ m.link.url | relative_url }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-link"></i>{{ m.link.label[page_lang] }}</a>
            {%- endif %}
          </div>
          {%- endif %}
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
  {%- endfor %}

  <dialog class="teach-lightbox" aria-label="{{ s_enlarge }}">
    <div class="teach-lightbox-media"></div>
    <div class="teach-lightbox-bar">
      <span></span>
      <a class="teach-lightbox-dl" href="#" download hidden><i class="fa-solid fa-download"></i> {{ s_download }}</a>
      <button type="button" class="teach-lightbox-close"><i class="fa-solid fa-xmark"></i> {{ s_close }}</button>
    </div>
  </dialog>

  <script>
  (function () {
    // load a video (and its poster) when it nears the screen; play it only while visible
    var videos = document.querySelectorAll('.teach-material video');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          var v = e.target;
          if (e.isIntersecting) {
            if (!v.src) { if (v.dataset.poster) v.poster = v.dataset.poster; v.src = v.dataset.src; }
            var p = v.play(); if (p && p.catch) p.catch(function () {});
          } else if (!v.paused) { v.pause(); }
        });
      }, { rootMargin: '300px 0px' });
      videos.forEach(function (v) { io.observe(v); });
    } else {
      videos.forEach(function (v) { if (v.dataset.poster) v.poster = v.dataset.poster; v.src = v.dataset.src; v.autoplay = true; });
    }

    // category filter
    var buttons = document.querySelectorAll('.teach-filter');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var cat = btn.getAttribute('data-cat');
        buttons.forEach(function (b) { b.classList.toggle('active', b === btn); });
        document.querySelectorAll('.teach-group').forEach(function (g) {
          g.hidden = cat !== '' && g.getAttribute('data-cat') !== cat;
        });
      });
    });

    // enlarged view
    var box = document.querySelector('.teach-lightbox');
    if (!box || !box.showModal) return;
    var holder = box.querySelector('.teach-lightbox-media');
    var caption = box.querySelector('.teach-lightbox-bar span');
    var dl = box.querySelector('.teach-lightbox-dl');
    document.querySelectorAll('.teach-media').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var title = btn.closest('.teach-material').querySelector('h4').textContent;
        holder.innerHTML = '';
        var el;
        if (btn.dataset.kind === 'video') {
          el = document.createElement('video');
          el.muted = true; el.loop = true; el.autoplay = true; el.playsInline = true; el.controls = true;
        } else {
          el = document.createElement('img'); el.alt = title;
        }
        el.src = btn.dataset.src;
        holder.appendChild(el);
        caption.textContent = title;
        dl.hidden = !btn.dataset.download;
        if (btn.dataset.download) dl.href = btn.dataset.download;
        box.showModal();
      });
    });
    function close() { box.close(); }
    box.querySelector('.teach-lightbox-close').addEventListener('click', close);
    box.addEventListener('click', function (e) { if (e.target === box) close(); });
    box.addEventListener('close', function () { holder.innerHTML = ''; });
  })();
  </script>
  {%- else %}
  <p class="teach-empty"><i class="fa-solid fa-film"></i>{{ s_materials_empty }}</p>
  {%- endif %}
</section>
